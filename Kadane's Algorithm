class Solution
{
public:
    int maxSubarraySum(vector<int> &arr)
    {
        // Code here
        int prefix = 0, maxi = INT_MIN;
        int n = arr.size();
        for (int i = 0; i < n; i++)
        {
            prefix = prefix + arr[i];
            maxi = max(prefix, maxi);
            if (prefix < 0)
            {
                prefix = 0;
            }
        }

        return maxi;
    }
};
