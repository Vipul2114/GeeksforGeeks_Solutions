class Solution {
public:
    vector<int> maxPrefixes(vector<int>& arr, vector<int>& leftIndex, vector<int>& rightIndex) {
        int q = leftIndex.size();
        vector<int> res;
        for (int k = 0; k < q; k++) {
            int l = leftIndex[k], r = rightIndex[k];
            int sum = 0, maxSum = INT_MIN;
            for (int i = l; i <= r; i++) {
                sum += arr[i];
                maxSum = max(maxSum, sum);
            }
            res.push_back(maxSum);
        }
        return res;
    }
};
